# 빗썸 API 키 (발급: https://www.bithumb.com/u1/US127)
BITHUMB_ACCESS_KEY=your_access_key_here
BITHUMB_SECRET_KEY=your_secret_key_here

# 텔레그램 봇 (BotFather에서 발급)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# 웹 대시보드 접근 보안
# WEB_PASSWORD: 대시보드 로그인 비밀번호 (미설정 시 인증 비활성)
# WEB_SECRET_KEY: 세션 서명 키 (미설정 시 매 실행마다 랜덤 생성 → 재시작 시 재로그인)
WEB_PASSWORD=
WEB_SECRET_KEY=
